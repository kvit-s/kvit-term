[31m|[m  qml/TodoDelegate.qml                  |   6 [32m+[m
[31m|[m  selection.md                          | 369 [32m+++++[m[31m-----------[m
[31m|[m  src/application/documentdecorations.h |  25 [32m+[m[31m-[m
[31m|[m  tests/CMakeLists.txt                  |  14 [32m+[m
[31m|[m  tests/test_documentview.cpp           | 549 [32m++++++++++++++++++++++++[m
