[31m|[m  src/application/startupcontroller.h   |  5 [32m++[m
[31m|[m  tests/test_documentmanager.cpp        | 53 [32m++++++++++++++++++[m
[31m|[m  tests/test_startupcontroller.cpp      | 71 [32m+++++++++++++++++++++++++[m
